# ===================================================
# Caspian Sentinel AI - Backend Environment Configuration
# ===================================================

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./teamops.db

# For PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# CORS Configuration (comma-separated or * for all)
CORS_ORIGINS=*

# Google Gemini AI (for Directive Extraction, Problem Breakdown & Autonomous Routing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Cloud API (for Ultra-Fast Whisper Speech-to-Text)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Auth Configuration (for Admin Passwordless Magic Link / Email OTP)
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
ANON_KEY=your_supabase_anon_key_here
SERVICE_KEY=your_supabase_service_role_key_here

# Caspian Bridge SDK (Optional for external Slack/Email webhooks)
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_SENDER_MAP={}
